{
  "name": "frontend-kalba",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo start",
    "start:dev": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo start",
    "android": "npm run android:debug:local",
    "android:dev": "npm run android:debug:remote",
    "android:debug:local": "node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo run:android",
    "android:debug:remote": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo run:android",
    "android:release:local": "adb reverse tcp:8000 tcp:8000 && node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo run:android --variant release --no-bundler",
    "android:release:remote": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo run:android --variant release --no-bundler",
    "android:smoke:local": "python test/automated/run_android_smoke_local.py",
    "android:smoke:remote": "python test/automated/run_android_smoke_remote.py",
    "android:eas:debug:remote": "npx eas-cli build -p android --profile development --non-interactive",
    "android:eas:release:remote": "npx eas-cli build -p android --profile tester --non-interactive",
    "android:eas:store:remote": "npx eas-cli build -p android --profile production --non-interactive",
    "ios": "node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo run:ios",
    "ios:device": "node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo run:ios --device",
    "ios:dev": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo run:ios",
    "ios:dev:device": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo run:ios --device",
    "web": "node -e \"try{require('fs').unlinkSync('.env.development.local')}catch(e){}\" && expo start --web",
    "web:dev": "node -e \"require('fs').copyFileSync('.env.dev','.env.development.local')\" && expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@daily-co/react-native-daily-js": "^0.83.0",
    "@daily-co/react-native-webrtc": "^124.0.6-daily.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.4",
    "expo": "~54.0.35",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.0.8",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.6",
    "react-native": "^0.81.5",
    "react-native-background-timer": "^2.4.1",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.9",
    "jscodeshift": "^17.3.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/jest",
        "jest-expo"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-background-timer"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "private": true
}