{
    "cli": {
        "version": ">= 18.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "tester": {
            "distribution": "internal",
            "environment": "production",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "env": {
                "EXPO_PUBLIC_APP_VARIANT": "test"
            }
        },
        "production": {
            "distribution": "store",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_APP_VARIANT": "production"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "ascAppId": "6761315112"
            }
        }
    }
}