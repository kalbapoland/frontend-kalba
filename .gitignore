# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Claude Code
.claude/

# AI agent generated links (source of truth is scripts/AIAgents/ — run setup.py after clone)
/CLAUDE.md
/.github/copilot-instructions.md
/.github/prompts/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local build outputs — kalba-*.apk live under android/**/build/ which is already ignored

# Metro
.metro-health-check*

# Automated UI test artifacts
test/automated/artifacts/
test/automated/tmp/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
.env

# typescript
*.tsbuildinfo

# Android native project is versioned for EAS builds.
# Keep generated artifacts and local secrets out of git.
android/.gradle/
android/**/build/
android/.cxx/
android/app/.cxx/
android/local.properties
android/app/google-services.json
# debug.keystore is intentionally NOT listed here — it is tracked in git so
# all developers share the same SHA-1 fingerprint. Register it once in Google
# Cloud Console for local OAuth to work. Password is public ('android').
android/app/debug.keystore.bk

# iOS is versioned to keep native config consistent across developers.
# Build artifacts are excluded here directly — don't rely on the Expo-generated
# ios/.gitignore, which is regenerated/removed on a clean prebuild.
ios/**/build/
ios/build/
ios/DerivedData/
ios/Pods/
ios/.symlinks/
ios/.xcode.env.local
ios/local.properties
ios/**/*.jsbundle
ios/**/*.hmap
ios/**/*.ipa
ios/**/project.xcworkspace/
ios/**/*.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.xcuserstate
ios/**/.DS_Store
ios/GoogleService-Info.plist

# JetBrains IDEs
.idea/

